# MongoDB connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DatabaseName

# Secret used to sign JWT tokens
JWT_SECRET=your_jwt_secret_here

# Razorpay keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM="DevConnect" <your_email@gmail.com>

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Optional: change if you want a different backend port
# PORT=3000
